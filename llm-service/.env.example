# LLM Provider: gemini | openrouter | openai_compatible
LLM_PROVIDER=gemini

# Google Gemini (required when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=

# OpenRouter / OpenAI-compatible (required when LLM_PROVIDER=openrouter or openai_compatible)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.5-flash

# Model settings
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_ANALYST_TEMPERATURE=0.2

# Task manager
TASK_TTL_SECONDS=3600
TASK_CLEANUP_INTERVAL_SECONDS=300

# App
APP_HOST=0.0.0.0
APP_PORT=8000
WORKERS=1
LOG_LEVEL=INFO
